{
  "name": "cbd-catalog-index",
  "private": true,
  "description": "The autocatalog index, installed apart from EventCatalog so each keeps its own React.",
  "type": "module",
  "scripts": {
    "build": "autocatalog site ../repos --base /cbd-catalog/autocatalog/ --out ../dist/autocatalog"
  },
  "devDependencies": {
    "autocatalog": "0.1.1"
  },
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "packageExtensions": {
      "autocatalog-docs-astro": {
        "dependencies": {
          "js-yaml": "^4.1.1"
        }
      }
    }
  }
}
